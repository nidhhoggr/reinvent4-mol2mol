{
  "docking": {
    "header": {
      "logging": {
        "logfile": "/workspace/results/dockstream.log"
      }
    },
    "ligand_preparation": {
      "embedding_pools": [
        {
          "pool_id": "RDkit",
          "type": "RDkit",
          "parameters": {
            "coordinate_generation": {
              "method": "UFF",
              "maximum_iterations": 450
            }
          },
          "input": {
            "standardize_smiles": false,
            "type": "console"
          }
        }
      ]
    },
    "docking_runs": [
      {
        "backend": "AutoDockVina",
        "run_id": "AutoDockVina",
        "input_pools": ["RDkit"],
        "parameters": {
          "binary_location": "/opt/conda/envs/reinvent4/bin",
          "parallelization": {
            "number_cores": 10
          },
          "seed": 42,
          "receptor_pdbqt_path": [
            "/workspace/docking_setup/receptor.pdbqt"
          ],
          "number_poses": 9,
          "search_space": {
            "--center_x": 1.56,
            "--center_y": 2.56,
            "--center_z": 18.4,
            "--size_x": 22.0,
            "--size_y": 22.0,
            "--size_z": 22.0
          }
        },
        "output": {
          "poses": {
            "poses_path": "/workspace/results/docked_poses.sdf"
          },
          "scores": {
            "scores_path": "/workspace/results/docked_scores.csv"
          }
        }
      }
    ]
  }
}
